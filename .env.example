PORT=4000

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# MongoDB
MONGODB_URI=mongodb://user:pass@host:27017/onward_app?ssl=true&retryWrites=true&w=majority
MONGODB_DB_NAME=onward_app

# Brevo (transactional email)
BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_EMAIL=mannat@onwardworkspaces.com
MAIL_FROM_NAME=Onward Workspaces
SUMMARY_TO=operations@onwardworkspaces.com
ERROR_NOTIFY_TO=operations@onwardworkspaces.com

# Cloudflare R2 (photo storage)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=onward-app
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# Timezone
APP_TIMEZONE=Asia/Kolkata
NOTIFY_DEADLINE=12:30
REMINDER_AT=11:00
SUMMARY_AT=18:00

# Force update
MIN_VERSION_ANDROID=1.0
MIN_VERSION_IOS=1.0
STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.onwardworkspaces.daily
STORE_URL_IOS=https://apps.apple.com/app/id0000000000
